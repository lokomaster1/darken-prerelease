<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <FrameLayout
        android:id="@+id/cell_minus5"
        style="@style/NotificationActionCell">
        <TextView
            android:id="@+id/action_minus5"
            style="@style/NotificationActionText"
            android:text="@string/notification_control_decrease_large" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_minus1"
        style="@style/NotificationActionCell">
        <TextView
            android:id="@+id/action_minus1"
            style="@style/NotificationActionText"
            android:text="@string/notification_control_decrease" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_level"
        style="@style/NotificationLevelCell">
        <TextView
            android:id="@+id/display_level"
            style="@style/NotificationLevelText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_stop"
        style="@style/NotificationActionCell">
        <TextView
            android:id="@+id/action_stop"
            style="@style/NotificationActionText"
            android:text="@string/notification_control_stop" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_plus1"
        style="@style/NotificationActionCell">
        <TextView
            android:id="@+id/action_plus1"
            style="@style/NotificationActionText"
            android:text="@string/notification_control_increase" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_plus5"
        style="@style/NotificationActionCell">
        <TextView
            android:id="@+id/action_plus5"
            style="@style/NotificationActionText"
            android:text="@string/notification_control_increase_large" />
    </FrameLayout>
</LinearLayout>
